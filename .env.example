# Public solder.py URL, also used in generated FileDirector remote pointers.
APP_URL=https://solder.example.com/
APP_PORT=8080
APP_DEBUG=false

# Use a long random value in production so login sessions survive restarts.
SECRET_KEY=
# Keep enabled whenever the management interface is served over HTTPS.
# Disable only for local development over plain HTTP.
SESSION_COOKIE_SECURE=True

# Public URL used by launchers and generated download manifests. Include a trailing slash.
PUBLIC_REPO_LOCATION=https://solder.example.com/mods/

# Internal source used for file-size checks, rehashing, and legacy MCIL JAR creation.
# Use either a direct HTTP(S) repository URL or an absolute local repository path.
# In the Docker image, /app/mods/ addresses the default mounted repository.
MD5_REPO_LOCATION=/app/mods/

# Required only for CurseForge modpack exports. Obtain a third-party API key
# from CurseForge and keep it out of source control.
CURSEFORGE_API_KEY=

# Optional. Public GitHub config repositories work without a token, but a
# token raises the API rate limit when browsing tags or synchronizing refs.
GITHUB_TOKEN=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_DATABASE=solderpy

R2_ENDPOINT=
R2_URL=https://solder.example.com/mods/
R2_BUCKET=
R2_REGION=
R2_ACCESS_KEY=123
R2_SECRET_KEY=123

# Enables the /setup page if the database already exists and you need to add a new user
NEW_USER=True

# Reconcile a current Technic Solder database during management startup. Run this before starting an API_ONLY instance with read-only database permissions.
TECHNIC_MIGRATION=True

# Enable authenticated write API routes. Disabled by default. API_ONLY by
# itself remains read-only; combine API_ONLY=True with WRITE_API=True for a
# dedicated API service that can write.
WRITE_API=False

# Show the legacy manual "Add Version" row above a mod's version list.
# Keep this disabled when versions are normally uploaded or imported.
ENABLE_LEGACY_MODVERSION_ADDING=False

# Caching options
# Set the cache maximum size. Default is 100.
CACHE_SIZE=100

# Set the cache TTL in seconds. Default is 300 seconds.
CACHE_TTL=300
